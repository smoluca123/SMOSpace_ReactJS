# API + Socket endpoints of the backend.
# Local development:
VITE_API_URL="http://localhost:8080"
VITE_SOCKET_URL="ws://localhost:8080"
# Production example (use https/wss):
# VITE_API_URL="https://your-api-domain"
# VITE_SOCKET_URL="wss://your-api-domain"

# Static authorization token expected by the backend's global guard.
# Obtain this from the backend configuration / team. Do not commit a real value.
VITE_AUTHORIZATION_TOKEN=""
